# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube al repo (está en .gitignore).
# Lo leen: la app en modo desarrollo (npm run dev), Prisma, los tests y docker compose.

# --- Base de datos -----------------------------------------------------------
# Desarrollo con `npm run dev` (Postgres de docker compose expuesto en el puerto 5432)
DATABASE_URL="postgresql://delycia:delycia@localhost:5432/delycia?schema=public"

# Base para los tests de integración (se vacía en cada corrida; la crea docker/postgres-init)
TEST_DATABASE_URL="postgresql://delycia:delycia@localhost:5432/delycia_test?schema=public"

# Contraseña de Postgres que usa docker compose (por defecto "delycia", solo para desarrollo).
# Si la cambias, cámbiala también en DATABASE_URL y TEST_DATABASE_URL.
# OJO: Postgres solo la aplica al crear el volumen (docker compose down -v la reinicia).
POSTGRES_PASSWORD="delycia"

# --- Sesión ------------------------------------------------------------------
# Secreto para firmar la cookie de sesión (mínimo 16 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# "true" solo cuando la app se sirve por HTTPS (ej. en AWS con dominio). En la red del local (http) = false.
COOKIE_SECURE="false"
