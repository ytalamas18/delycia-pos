# Copia este archivo a .env y ajusta los valores.

# Base de datos (docker-compose expone Postgres en el puerto 5432)
DATABASE_URL="postgresql://delycia:delycia@localhost:5432/delycia?schema=public"

# Base de datos para los tests de integración (se vacía en cada corrida)
TEST_DATABASE_URL="postgresql://delycia:delycia@localhost:5432/delycia_test?schema=public"

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
