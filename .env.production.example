# Variables de PRODUCCIÓN para docker-compose.prod.yml. Plantilla SIN valores reales.
# En la EC2 no se edita a mano: infra/user-data.sh genera /opt/delycia/.env (permisos 600) y
# conserva los secretos si ya existían. Para volver a generarlo: sudo /usr/local/sbin/delycia-setup

# URL pública. Hoy, sin dominio: http://<IP pública>. Con dominio: https://pos.tudominio.com
APP_URL=""

# Dirección del sitio para Caddy: ":80" = HTTP por IP. Con dominio (o IP-CON-GUIONES.sslip.io)
# Caddy saca el certificado HTTPS solo. Ver Caddyfile.
SITE_ADDRESS=":80"

# Flag Secure de la cookie. Vacío = se deduce de APP_URL (http → false, https → true).
COOKIE_SECURE="false"

# Contraseña de Postgres. Se fija al CREAR el volumen: cambiarla después exige ALTER USER dentro de Postgres.
POSTGRES_PASSWORD=""

# Firma de la cookie de sesión (mínimo 16 caracteres). Cambiarlo cierra todas las sesiones.
SESSION_SECRET=""

# "true" carga UNA vez el menú real (prisma/data/menu-delycia.json). "false" = solo usuarios y ajustes.
SEED_MENU="true"

# PIN iniciales (4 dígitos). Solo se usan al CREAR los usuarios; después se cambian en Ajustes.
ADMIN_PIN=""
CAJA_PIN=""
COCINA_PIN=""
