// Modelo de datos de Delycia POS.
//
// Convenciones:
// - Montos en centavos (Int). Nunca Float.
// - Todas las tablas tienen createdAt/updatedAt; los cambios de estado guardan su propia hora.
// - Las secciones están separadas por módulo. Un módulo solo lee/escribe SUS tablas
//   (las FK entre módulos existen solo para integridad).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// TRANSVERSAL (core)
// ============================================================================

enum Role {
  ADMIN
  CASHIER
  KITCHEN
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  pinHash   String
  role      Role
  active    Boolean  @default(true)
  orders    Order[]  @relation("OrderCreatedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Outbox de eventos de dominio. El id secuencial es el Last-Event-ID del SSE.
model DomainEvent {
  id        BigInt   @id @default(autoincrement())
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Ajustes editables desde la app (ej. % PEYA, umbrales del KDS).
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// CATÁLOGO
// ============================================================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String            @id @default(cuid())
  categoryId     String
  category       Category          @relation(fields: [categoryId], references: [id])
  name           String
  priceCents     Int
  /// false = no genera comanda (ej. gaseosas).
  sendsToKitchen Boolean           @default(true)
  active         Boolean           @default(true)
  sortOrder      Int               @default(0)
  modifiers      ProductModifier[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([categoryId, name])
  @@index([active])
}

/// Opciones rápidas por producto, ej. "sin cebolla" (0) o "extra queso" (+5 Bs).
model ProductModifier {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaCents Int      @default(0)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, name])
}

// ============================================================================
// VENTAS
// ============================================================================

enum SalesChannel {
  LOCAL
  PEYA
}

enum ServiceType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  PAID
  CLOSED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  VOIDED
}

enum DiscountType {
  AMOUNT
  PERCENT
}

enum PaymentMethod {
  CASH
  QR
  CARD
  PEYA
  /// Cuenta por cobrar (fiado): se registra la deuda y se cobra después.
  CREDIT
}

/// Correlativo de órdenes por día de negocio (zona horaria del local).
model DailyCounter {
  businessDate String   @id // "2026-10-17"
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                   String           @id @default(cuid())
  businessDate         String // día de negocio, para el número y los reportes
  number               Int
  channel              SalesChannel     @default(LOCAL)
  /// % de recargo aplicado si channel = PEYA (copia al momento de abrir la orden).
  channelMarkupPercent Decimal          @default(0) @db.Decimal(5, 2)
  serviceType          ServiceType
  tableNumber          String?
  customerName         String?
  status               OrderStatus      @default(OPEN)
  subtotalCents        Int              @default(0)
  discountType         DiscountType?
  discountValue        Decimal?         @db.Decimal(10, 2)
  discountCents        Int              @default(0)
  totalCents           Int              @default(0)
  openedAt             DateTime         @default(now())
  paidAt               DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdById          String
  createdBy            User             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items                OrderItem[]
  payments             Payment[]
  statusLog            OrderStatusLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([businessDate, number])
  @@index([status])
  @@index([businessDate])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  productId       String
  // --- copia del producto al momento de la venta ---
  productName     String
  /// Precio de lista del producto (sin recargo de canal).
  listPriceCents  Int
  /// Precio unitario cobrado (con recargo PEYA y modificadores incluidos).
  unitPriceCents  Int
  sendsToKitchen  Boolean
  /// [{ name, priceDeltaCents }]
  modifiers       Json            @default("[]")
  // ---
  quantity        Int
  note            String?
  /// Hereda el de la orden; se puede cambiar por ítem (ej. mesa que pide un plato para llevar).
  serviceType     ServiceType
  status          OrderItemStatus @default(ACTIVE)
  /// null = todavía no se envió a cocina.
  sentToKitchenAt DateTime?
  voidReason      String?
  voidedAt        DateTime?
  voidedById      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
}

model Payment {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  /// Monto aplicado a la cuenta.
  amountCents   Int
  /// Solo efectivo: lo que entregó el cliente y el vuelto.
  tenderedCents Int?
  changeCents   Int?
  /// Si la orden se anula después de pagada, el pago queda como devuelto (no se borra).
  refundedAt    DateTime?
  /// Solo CUENTA POR COBRAR: a nombre de quién quedó la deuda y cuándo se terminó de pagar.
  debtorName    String?
  settledAt     DateTime?
  collections   CreditCollection[]
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([orderId])
  @@index([method])
  @@index([settledAt])
}

/// Cobro (total o parcial) de una cuenta por cobrar (fiado).
model CreditCollection {
  id          String        @id @default(cuid())
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id])
  method      PaymentMethod
  amountCents Int
  createdById String
  createdAt   DateTime      @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  userId     String?
  at         DateTime     @default(now())

  @@index([orderId])
}

// ============================================================================
// COCINA (solo copias: no consulta tablas de ventas)
// ============================================================================

enum TicketStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model KitchenTicket {
  id          String              @id @default(cuid())
  orderId     String
  orderNumber Int
  /// 1 = comanda original; 2, 3... = adicionales de la misma orden.
  sequence    Int
  channel     SalesChannel
  /// Tipo de la orden: en una orden "comer aquí", los ítems para llevar se resaltan.
  serviceType ServiceType         @default(DINE_IN)
  /// "Mesa 4" / "Para llevar · Juan" / "PEYA · Ana"
  label       String
  status      TicketStatus        @default(PENDING)
  receivedAt  DateTime            @default(now())
  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  items       KitchenTicketItem[]
  statusLog   TicketStatusLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([orderId, sequence])
  @@index([status])
}

model KitchenTicketItem {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      KitchenTicket @relation(fields: [ticketId], references: [id])
  orderItemId String        @unique
  name        String
  quantity    Int
  /// ["sin cebolla", ...]
  modifiers   Json          @default("[]")
  note        String?
  serviceType ServiceType
  readyAt     DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId])
}

/// Historial de cambios de estado: permite "deshacer" y medir tiempos de preparación.
model TicketStatusLog {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     KitchenTicket @relation(fields: [ticketId], references: [id])
  fromStatus TicketStatus?
  toStatus   TicketStatus
  userId     String?
  at         DateTime      @default(now())

  @@index([ticketId])
}

/// Cierre de caja de un día de negocio. Se puede volver a guardar (corregir) ese mismo día.
model CashClosing {
  id                String   @id @default(cuid())
  businessDate      String   @unique
  /// Fondo con el que abrió la caja.
  openingCashCents  Int      @default(0)
  /// Efectivo esperado = fondo + efectivo de ventas + efectivo cobrado de fiados.
  expectedCashCents Int
  /// Efectivo contado al cerrar (arqueo).
  countedCashCents  Int
  /// Contado - esperado (negativo = falta, positivo = sobra).
  differenceCents   Int
  /// QR y tarjeta: lo que registró el sistema vs. lo que muestra el banco / el datáfono.
  expectedQrCents   Int      @default(0)
  countedQrCents    Int?
  expectedCardCents Int      @default(0)
  countedCardCents  Int?
  notes             String?
  /// Copia del resumen del día al momento del cierre.
  summary           Json
  closedById        String
  closedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Apertura de caja: efectivo con el que empieza el día (fondo). Una por día de negocio y no editable.
model CashOpening {
  id               String   @id @default(cuid())
  businessDate     String   @unique
  openingCashCents Int
  notes            String?
  openedById       String
  openedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
