// Modelo de datos de Delycia POS.
//
// Convenciones:
// - Montos en centavos (Int). Nunca Float.
// - Todas las tablas tienen createdAt/updatedAt; los cambios de estado guardan su propia hora.
// - Las secciones están separadas por módulo. Un módulo solo lee/escribe SUS tablas
//   (las FK entre módulos existen solo para integridad).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// TRANSVERSAL (core)
// ============================================================================

/// Perfil fijo de la primera versión (antes de los roles). Ya no se usa: se conserva para poder volver
/// a la versión anterior sin perder datos y se borra en una migración futura.
enum LegacyRole {
  ADMIN
  CASHIER
  KITCHEN

  @@map("Role")
}

/// Rol: nombre + lista de permisos (claves del catálogo de core/auth/permissions.ts).
/// Los roles de sistema (systemKey) se crean en la migración; el Admin tiene siempre todos los permisos
/// (se calculan en código, `permissions` se ignora). Los roles no se borran: se desactivan.
model Role {
  id          String   @id @default(cuid())
  name        String
  /// Nombre normalizado (minúsculas, sin espacios extra): impide "Mesero" y "mesero".
  nameKey     String   @unique
  /// ADMIN | CASHIER | KITCHEN para los roles creados por el sistema; null para los creados en la app.
  systemKey   String?  @unique
  permissions String[]
  active      Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // La tabla "Role" no puede existir: Postgres ya tiene el tipo enum "Role" (LegacyRole).
  @@map("AccessRole")
}

model User {
  id                String      @id @default(cuid())
  /// Nombre completo (el que se muestra en historial, cierres, etc.).
  name              String
  /// Nombre de usuario para entrar, guardado en minúsculas (único sin distinguir mayúsculas).
  username          String      @unique
  pinHash           String
  roleId            String
  role              Role        @relation(fields: [roleId], references: [id])
  legacyRole        LegacyRole? @map("role")
  active            Boolean     @default(true)
  /// Sube al resetear el PIN: invalida las sesiones abiertas (la cookie guarda la versión).
  sessionVersion    Int         @default(0)
  /// Intentos de PIN fallidos seguidos; al llegar al límite se bloquea un rato (lockedUntil).
  failedPinAttempts Int         @default(0)
  lockedUntil       DateTime?
  orders            Order[]     @relation("OrderCreatedBy")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([roleId])
}

/// Outbox de eventos de dominio. El id secuencial es el Last-Event-ID del SSE.
model DomainEvent {
  id        BigInt   @id @default(autoincrement())
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Ajustes editables desde la app (ej. % PEYA, umbrales del KDS).
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// CATÁLOGO
// ============================================================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Cómo se comporta un ítem (la categoría solo agrupa).
enum ItemType {
  /// Se vende tal cual (ej. gaseosa). Stock solo si tracksStock.
  NORMAL
  /// Se vende y tiene receta que descuenta stock (ej. hamburguesa). Nunca tiene stock propio.
  PREPARED
  /// Se produce en cocina (ej. carne de hamburguesa). No se vende. Siempre tiene stock.
  INGREDIENT
  /// Se compra (ej. carne molida, pan). No se vende. Stock solo si tracksStock.
  SUPPLY
}

/// Unidad base del ítem: en ella se guardan stock, recetas y costos.
enum BaseUnit {
  UNIT
  KG
  G
  L
  ML
}

/// "Ítem" del catálogo: productos de venta, ingredientes e insumos.
model Product {
  id             String                @id @default(cuid())
  categoryId     String
  category       Category              @relation(fields: [categoryId], references: [id])
  name           String
  /// Precio de venta. Solo NORMAL y PREPARED se venden; INGREDIENT y SUPPLY quedan en 0.
  priceCents     Int
  /// false = no genera comanda (ej. gaseosas).
  sendsToKitchen Boolean               @default(true)
  active         Boolean               @default(true)
  sortOrder      Int                   @default(0)
  type           ItemType              @default(NORMAL)
  baseUnit       BaseUnit              @default(UNIT)
  /// "Suma al inventario al registrar compra". INGREDIENT siempre true; PREPARED siempre false.
  tracksStock    Boolean               @default(false)
  /// Alerta cuando el stock baja de aquí (en unidad base). Solo si tracksStock.
  minStock       Decimal?              @db.Decimal(12, 3)
  /// Último costo por unidad base, en centavos con decimales (1 g puede costar menos de 1 centavo).
  lastCostCents  Decimal?              @db.Decimal(14, 4)
  lastCostAt     DateTime?
  /// Solo Ingrediente: cuánto rinde su receta de referencia (en su unidad base), ej. 16 unidades.
  recipeYield    Decimal?              @db.Decimal(12, 3)
  modifiers      ProductModifier[]
  presentations  ProductPresentation[]
  recipeLines    RecipeLine[]          @relation("RecipeOwner")
  usedInRecipes  RecipeLine[]          @relation("RecipeComponent")
  usedInModifier ModifierRecipeLine[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([categoryId, name])
  @@index([active])
  @@index([type])
}

/// Presentación de compra, ej. "Bolsa x12" = 12 unidades base. Al comprar 2 bolsas suma 24.
model ProductPresentation {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  /// Cuántas unidades base trae una presentación.
  factor    Decimal  @db.Decimal(12, 3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
}

/// Opciones rápidas por producto, ej. "sin cebolla" (0) o "extra queso" (+5 Bs).
model ProductModifier {
  id              String               @id @default(cuid())
  productId       String
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceDeltaCents Int                  @default(0)
  active          Boolean              @default(true)
  sortOrder       Int                  @default(0)
  /// Lo que descuenta del stock al venderse (ej. "Extra queso" → 1 lámina de queso).
  recipeLines     ModifierRecipeLine[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([productId, name])
}

/// Cuándo aplica una línea de receta según el ítem de la orden (PEYA siempre es para llevar).
enum RecipeCondition {
  ALWAYS
  TAKEAWAY
  DINE_IN
}

/**
 * Línea de receta.
 * - Dueño Preparado: componentes Normal/Insumo/Ingrediente; al vender descuenta los que manejan stock.
 * - Dueño Ingrediente: solo Insumos; es referencia de costo (rinde `recipeYield`), NO descuenta stock.
 * Cantidad en la unidad base del componente.
 */
model RecipeLine {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation("RecipeOwner", fields: [productId], references: [id], onDelete: Cascade)
  componentId String
  component   Product         @relation("RecipeComponent", fields: [componentId], references: [id])
  quantity    Decimal         @db.Decimal(12, 3)
  condition   RecipeCondition @default(ALWAYS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([productId, componentId, condition])
  @@index([componentId])
}

/// Lo que descuenta un modificador al venderse (por cada unidad del ítem). Cantidad en unidad base del componente.
model ModifierRecipeLine {
  id          String          @id @default(cuid())
  modifierId  String
  modifier    ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  componentId String
  component   Product         @relation(fields: [componentId], references: [id])
  quantity    Decimal         @db.Decimal(12, 3)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([modifierId, componentId])
  @@index([componentId])
}

// ============================================================================
// VENTAS
// ============================================================================

enum SalesChannel {
  LOCAL
  PEYA
}

enum ServiceType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  PAID
  CLOSED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  VOIDED
}

enum DiscountType {
  AMOUNT
  PERCENT
}

enum PaymentMethod {
  CASH
  QR
  CARD
  PEYA
  /// Cuenta por cobrar (fiado): se registra la deuda y se cobra después.
  CREDIT
}

/// Correlativo de órdenes por día de negocio (zona horaria del local).
model DailyCounter {
  businessDate String   @id // "2026-10-17"
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                   String           @id @default(cuid())
  businessDate         String // día de negocio, para el número y los reportes
  number               Int
  channel              SalesChannel     @default(LOCAL)
  /// % de recargo aplicado si channel = PEYA (copia al momento de abrir la orden).
  channelMarkupPercent Decimal          @default(0) @db.Decimal(5, 2)
  serviceType          ServiceType
  tableNumber          String?
  customerName         String?
  status               OrderStatus      @default(OPEN)
  subtotalCents        Int              @default(0)
  discountType         DiscountType?
  discountValue        Decimal?         @db.Decimal(10, 2)
  discountCents        Int              @default(0)
  totalCents           Int              @default(0)
  openedAt             DateTime         @default(now())
  paidAt               DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  /// Quién anuló y, si fue Caja, el Admin que autorizó con su PIN (si anuló un Admin, es él mismo).
  cancelledById        String?
  cancelAuthorizedById String?
  createdById          String
  createdBy            User             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items                OrderItem[]
  payments             Payment[]
  statusLog            OrderStatusLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([businessDate, number])
  @@index([status])
  @@index([businessDate])
  @@index([cancelledAt])
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id])
  productId          String
  // --- copia del producto al momento de la venta ---
  productName        String
  /// Precio de lista del producto (sin recargo de canal).
  listPriceCents     Int
  /// Precio unitario cobrado (con recargo PEYA y modificadores incluidos).
  unitPriceCents     Int
  sendsToKitchen     Boolean
  /// [{ name, priceDeltaCents }]
  modifiers          Json            @default("[]")
  // ---
  quantity           Int
  note               String?
  /// Hereda el de la orden; se puede cambiar por ítem (ej. mesa que pide un plato para llevar).
  serviceType        ServiceType
  status             OrderItemStatus @default(ACTIVE)
  /// null = todavía no se envió a cocina.
  sentToKitchenAt    DateTime?
  voidReason         String?
  voidedAt           DateTime?
  voidedById         String?
  /// Admin que autorizó la anulación (el mismo voidedById si anuló un Admin).
  voidAuthorizedById String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@index([voidedAt])
}

model Payment {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  /// Monto aplicado a la cuenta.
  amountCents   Int
  /// Solo efectivo: lo que entregó el cliente y el vuelto.
  tenderedCents Int?
  changeCents   Int?
  /// Si la orden se anula después de pagada, el pago queda como devuelto (no se borra).
  refundedAt    DateTime?
  /// Solo CUENTA POR COBRAR: a nombre de quién quedó la deuda y cuándo se terminó de pagar.
  debtorName    String?
  settledAt     DateTime?
  collections   CreditCollection[]
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([orderId])
  @@index([method])
  @@index([settledAt])
}

/// Cobro (total o parcial) de una cuenta por cobrar (fiado).
model CreditCollection {
  id          String        @id @default(cuid())
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id])
  method      PaymentMethod
  amountCents Int
  createdById String
  createdAt   DateTime      @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  userId     String?
  at         DateTime     @default(now())

  @@index([orderId])
}

// ============================================================================
// COCINA (solo copias: no consulta tablas de ventas)
// ============================================================================

enum TicketStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model KitchenTicket {
  id          String              @id @default(cuid())
  orderId     String
  orderNumber Int
  /// 1 = comanda original; 2, 3... = adicionales de la misma orden.
  sequence    Int
  channel     SalesChannel
  /// Tipo de la orden: en una orden "comer aquí", los ítems para llevar se resaltan.
  serviceType ServiceType         @default(DINE_IN)
  /// "Mesa 4" / "Para llevar · Juan" / "PEYA · Ana"
  label       String
  status      TicketStatus        @default(PENDING)
  receivedAt  DateTime            @default(now())
  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  /// Caja anuló algo de esta comanda mientras estaba en cocina: aviso en rojo hasta que cocina toque "Entendido".
  voidAlertAt DateTime?
  items       KitchenTicketItem[]
  statusLog   TicketStatusLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([orderId, sequence])
  @@index([status])
}

model KitchenTicketItem {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      KitchenTicket @relation(fields: [ticketId], references: [id])
  orderItemId String        @unique
  name        String
  quantity    Int
  /// ["sin cebolla", ...]
  modifiers   Json          @default("[]")
  note        String?
  serviceType ServiceType
  readyAt     DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId])
}

/// Mensaje rápido de caja a cocina ("LLEGÓ GENTE", "MÁS PAPA"...). Queda visible hasta que cocina lo marca visto.
model KitchenMessage {
  id                 String    @id @default(cuid())
  text               String
  senderId           String
  senderName         String
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  acknowledgedByName String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([acknowledgedAt])
  @@index([createdAt])
}

/// Historial de cambios de estado: permite "deshacer" y medir tiempos de preparación.
model TicketStatusLog {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     KitchenTicket @relation(fields: [ticketId], references: [id])
  fromStatus TicketStatus?
  toStatus   TicketStatus
  userId     String?
  at         DateTime      @default(now())

  @@index([ticketId])
}

/// Cierre de caja de un día de negocio. Se puede volver a guardar (corregir) ese mismo día.
model CashClosing {
  id                String   @id @default(cuid())
  businessDate      String   @unique
  /// Fondo con el que abrió la caja.
  openingCashCents  Int      @default(0)
  /// Efectivo esperado = fondo + efectivo de ventas + efectivo cobrado de fiados.
  expectedCashCents Int
  /// Efectivo contado al cerrar (arqueo).
  countedCashCents  Int
  /// Contado - esperado (negativo = falta, positivo = sobra).
  differenceCents   Int
  /// QR y tarjeta: lo que registró el sistema vs. lo que muestra el banco / el datáfono.
  expectedQrCents   Int      @default(0)
  countedQrCents    Int?
  expectedCardCents Int      @default(0)
  countedCardCents  Int?
  notes             String?
  /// Copia del resumen del día al momento del cierre.
  summary           Json
  closedById        String
  closedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Apertura de caja: efectivo con el que empieza el día (fondo). Una por día de negocio y no editable.
model CashOpening {
  id               String   @id @default(cuid())
  businessDate     String   @unique
  openingCashCents Int
  notes            String?
  openedById       String
  openedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// COMPRAS
// ============================================================================

model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  phone     String?
  /// RUC / NIT / CI (opcional).
  document  String?
  note      String?
  active    Boolean    @default(true)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum PurchaseDocType {
  /// Boleta / nota de venta
  RECEIPT
  INVOICE
  NONE
}

/// Cómo se paga a un proveedor (distinto de los medios de cobro del POS).
enum SupplierPaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum PurchaseStatus {
  ACTIVE
  CANCELLED
}

/**
 * Compra de ítems. El gasto se registra por el TOTAL en `date` aunque no esté pagada;
 * lo pagado son los `payments` (cada uno con su fecha: ahí sale el dinero).
 */
model Purchase {
  id            String            @id @default(cuid())
  number        Int               @unique @default(autoincrement())
  /// Fecha de la compra (día de negocio "YYYY-MM-DD").
  date          String
  supplierId    String?
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  docType       PurchaseDocType   @default(NONE)
  docNumber     String?
  totalCents    Int
  /// Vencimiento opcional de lo que queda por pagar ("YYYY-MM-DD").
  dueDate       String?
  note          String?
  status        PurchaseStatus    @default(ACTIVE)
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  createdById   String
  lines         PurchaseLine[]
  payments      SupplierPayment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([date])
  @@index([supplierId])
  @@index([status])
}

/// Línea de compra. Guarda copia del ítem y de la presentación (cambiar el catálogo no altera compras).
model PurchaseLine {
  id               String   @id @default(cuid())
  purchaseId       String
  purchase         Purchase @relation(fields: [purchaseId], references: [id])
  productId        String
  productName      String
  /// "Bolsa x12" o la unidad ("kg") en que se compró.
  presentationName String
  /// Cantidad comprada en esa presentación/unidad.
  quantity         Decimal  @db.Decimal(12, 3)
  /// Cantidad convertida a la unidad base del ítem.
  baseQuantity     Decimal  @db.Decimal(12, 3)
  totalCents       Int
  /// Costo por unidad base (centavos con decimales) = total ÷ cantidad base.
  unitCostCents    Decimal  @db.Decimal(14, 4)
  /// Copia de "suma al inventario": si true, la compra sumó stock.
  addsStock        Boolean
  createdAt        DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

/// Pago (contado, parcial o abono) a una compra. Anular no borra: queda con motivo.
model SupplierPayment {
  id          String                @id @default(cuid())
  purchaseId  String
  purchase    Purchase              @relation(fields: [purchaseId], references: [id])
  /// Día en que salió el dinero ("YYYY-MM-DD"): ahí cuenta en el cierre de caja si es efectivo.
  date        String
  amountCents Int
  method      SupplierPaymentMethod
  note        String?
  voidedAt    DateTime?
  voidReason  String?
  voidedById  String?
  createdById String
  createdAt   DateTime              @default(now())

  @@index([purchaseId])
  @@index([date])
}

// ============================================================================
// INVENTARIO
// ============================================================================

enum StockMovementType {
  /// Inventario inicial (puesta en marcha / carga rápida).
  INITIAL
  PURCHASE
  PURCHASE_REVERSAL
  /// Ingreso a inventario (producción de un Ingrediente).
  PRODUCTION
  SALE
  SALE_REVERSAL
  /// Diferencia de un conteo físico (merma o sobrante).
  ADJUSTMENT
  /// Salida rápida (ej. envase para sobras).
  CONSUMPTION
}

/**
 * Kárdex: TODO cambio de stock es un movimiento. El stock = suma de `quantity` (nunca se edita a mano).
 * `refType`/`refId`/`refLineId` apuntan al documento de origen (orden, compra, producción, conteo...).
 */
model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  type          StockMovementType
  /// + entra, − sale (en unidad base del ítem).
  quantity      Decimal           @db.Decimal(12, 3)
  /// Costo por unidad base al momento del movimiento (centavos con decimales).
  unitCostCents Decimal?          @db.Decimal(14, 4)
  businessDate  String
  at            DateTime          @default(now())
  userId        String?
  refType       String
  refId         String
  refLineId     String?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([productId, at])
  @@index([refType, refId])
  @@index([refLineId])
  @@index([businessDate])
  @@index([type])
}

/// Ingreso a inventario de un Ingrediente producido en cocina.
model ProductionEntry {
  id            String   @id @default(cuid())
  productId     String
  productName   String
  quantity      Decimal  @db.Decimal(12, 3)
  unitCostCents Decimal? @db.Decimal(14, 4)
  date          String
  note          String?
  userId        String
  createdAt     DateTime @default(now())

  @@index([date])
}

/// Conteo físico: lo contado vs. el stock teórico; la diferencia se registra como ajuste.
model StockCount {
  id        String           @id @default(cuid())
  date      String
  note      String?
  userId    String
  lines     StockCountLine[]
  createdAt DateTime         @default(now())

  @@index([date])
}

model StockCountLine {
  id            String     @id @default(cuid())
  countId       String
  count         StockCount @relation(fields: [countId], references: [id])
  productId     String
  productName   String
  expected      Decimal    @db.Decimal(12, 3)
  counted       Decimal    @db.Decimal(12, 3)
  /// counted − expected (negativo = merma, positivo = sobrante).
  difference    Decimal    @db.Decimal(12, 3)
  unitCostCents Decimal?   @db.Decimal(14, 4)
  reason        String?

  @@index([countId])
  @@index([productId])
}
